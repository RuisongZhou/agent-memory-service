# Optional; leave empty for offline tests. Never commit a real key.
QWEN_API_KEY=
# OpenAI-compatible endpoint and generation model used by scripts/serve.py.
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# Supported pipeline: mem0.
MEMORY_STRATEGY=mem0

# Embedding and rerank models. "api" (default) uses the hosted models below with an API key;
# "self-hosted" uses your own llama-server processes (docs/self-hosted-models.md).
MEMORY_MODEL_PROVIDER=api
# Key for the hosted embedding/rerank models; QWEN_API_KEY is used when this is empty.
MEMORY_MODEL_API_KEY=
MEMORY_EMBED_MODEL=qwen3.7-text-embedding-flash
MEMORY_RERANK_MODEL=qwen3.7-text-rerank
# Base URLs. Leave empty for the provider default: the hosted endpoints
# (https://maas.qianwenaiapi.com/compatible-mode/v1 for /embeddings and
# https://maas.qianwenaiapi.com/compatible-api/v1 for /reranks), or
# http://127.0.0.1:8081 and http://127.0.0.1:8082 when self-hosted.
MEMORY_EMBED_URL=
MEMORY_RERANK_URL=
